From a5104fa6b6a27dfa16429372401a275deb4f4fe1 Mon Sep 17 00:00:00 2001
From: dolf3131 <144650661+dolf3131@users.noreply.github.com>
Date: Tue, 20 Oct 2026 18:52:06 +0900
Subject: [PATCH] EXL3 n-gram table: whole-row gather split over threads
 (TF_NGRAM_GATHER_THREADS, default 16; 0 = byte-wise)

A prompt's first piece has no read-ahead, so its gather faulted the table pages in one at a time
(0.5-0.8 s idle GPU before a new conversation's first kernel, stage18 nsys + py-spy). Rows are now
copied whole from int16 views of the same maps (their madvise applies) and a lookup of 512+ rows per
thread splits over up to 16 threads. Same bytes as before (tests + real-table bench).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../families/qwen4_exp/cuda/exl3_pack.py      | 58 ++++++++++++++++++-
 tests/test_exl3_ngram_table.py                | 30 ++++++++++
 2 files changed, 87 insertions(+), 1 deletion(-)

diff --git a/src/tensorfold/families/qwen4_exp/cuda/exl3_pack.py b/src/tensorfold/families/qwen4_exp/cuda/exl3_pack.py
index 76b2cd7e..5af2c271 100644
--- a/src/tensorfold/families/qwen4_exp/cuda/exl3_pack.py
+++ b/src/tensorfold/families/qwen4_exp/cuda/exl3_pack.py
@@ -133,6 +133,31 @@ def _libc():
     return libc
 
 
+def _gather_threads() -> int:
+    """TF_NGRAM_GATHER_THREADS (default 16): threads one n-gram lookup may split over; 1 keeps one thread, 0 the old
+    byte-wise gather. Every setting returns the same bytes."""
+
+    raw = os.environ.get("TF_NGRAM_GATHER_THREADS", "16")
+    n = int(raw)
+    if not 0 <= n <= 64:
+        raise ValueError(f"TF_NGRAM_GATHER_THREADS: 0..64, not {raw!r}")
+    return n
+
+
+GATHER_THREADS = _gather_threads()
+GATHER_SPLIT = 512                # rows a gather thread takes at least: decode rounds' lookups stay on one thread
+_GATHER_POOL = None
+
+
+def _gather_pool():
+    from concurrent.futures import ThreadPoolExecutor
+
+    global _GATHER_POOL
+    if _GATHER_POOL is None:
+        _GATHER_POOL = ThreadPoolExecutor(max_workers=GATHER_THREADS, thread_name_prefix="ngram-gather")
+    return _GATHER_POOL
+
+
 class NgramTable(_Residency):
     """The n-gram table in ExLlamaV3's row codec (one tensor or shards), memory-mapped; reads as ``HostTable``'s."""
 
@@ -188,6 +213,9 @@ class NgramTable(_Residency):
         self.starts = np.array(starts, dtype=np.int64)
         self.rows = int(self.starts[-1])
         self.row_bytes = 2 * self.words_per_row
+        # the same packed rows as int16 [rows, words] views of the whole-file maps (their madvise applies to these reads)
+        self.row_views = [self.maps[f][o:o + (b - a) * self.row_bytes].view(np.int16).reshape(b - a, self.words_per_row)
+                          for f, o, a, b in zip(fidx, offsets, starts[:-1], starts[1:])]
         self.nbytes = sum(a.nbytes for a in self.words)      # what the startup prefetch sizes, as for every table
         self.head_bias = pk.get(base + "head_bias").to(torch.float16).to(device).contiguous()
         self.head_offsets = pk.get(base + "head_offsets").cpu().numpy()
@@ -198,11 +226,39 @@ class NgramTable(_Residency):
         self._pins = Pins()
 
     def gather(self, ids: np.ndarray) -> np.ndarray:
-        """Rows ``ids`` (global) -> int16 [n, words]."""
+        """Rows ``ids`` (global) -> int16 [n, words]: whole rows from ``row_views``; a lookup of GATHER_SPLIT rows or more
+        splits them over up to GATHER_THREADS threads, so rows not in memory fault in parallel instead of one page at a
+        time (a prompt's first piece has no read-ahead). The same bytes as the byte-wise gather (TF_NGRAM_GATHER_THREADS=0)."""
 
         flat = np.asarray(ids, dtype=np.int64).reshape(-1)
         if np.any(flat < 0) or np.any(flat >= self.rows):
             raise IndexError(f"n-gram row outside [0, {self.rows})")
+        if GATHER_THREADS == 0:
+            return self._gather_bytes(flat)
+        out = np.empty((len(flat), self.words_per_row), dtype=np.int16)
+        workers = min(GATHER_THREADS, len(flat) // GATHER_SPLIT)
+        if workers > 1:
+            cuts = np.linspace(0, len(flat), workers + 1).astype(np.int64)
+            list(_gather_pool().map(lambda span: self._rows_into(flat, out, *span), zip(cuts[:-1], cuts[1:])))
+        else:
+            self._rows_into(flat, out, 0, len(flat))
+        return out
+
+    def _rows_into(self, flat: np.ndarray, out: np.ndarray, lo: int, hi: int) -> None:
+        """out[lo:hi] = rows flat[lo:hi] (numpy drops the GIL while it copies, so parallel calls fault in parallel)."""
+
+        sub = flat[lo:hi]
+        if len(self.row_views) == 1:
+            out[lo:hi] = self.row_views[0][sub]
+            return
+        shard = np.searchsorted(self.starts, sub, side="right") - 1
+        for s in np.unique(shard):
+            sel = np.nonzero(shard == s)[0]
+            out[lo + sel] = self.row_views[s][sub[sel] - self.starts[s]]
+
+    def _gather_bytes(self, flat: np.ndarray) -> np.ndarray:
+        """The byte-wise gather on one thread (TF_NGRAM_GATHER_THREADS=0)."""
+
         shard = np.searchsorted(self.starts, flat, side="right") - 1
         at = self.offsets[shard] + (flat - self.starts[shard]) * self.row_bytes
         where = self.fidx[shard]
diff --git a/tests/test_exl3_ngram_table.py b/tests/test_exl3_ngram_table.py
index 123c5d3d..1109189c 100644
--- a/tests/test_exl3_ngram_table.py
+++ b/tests/test_exl3_ngram_table.py
@@ -36,6 +36,36 @@ def test_the_exl3_ngram_table_reports_bytes_and_gathers_layouts(tmp_path, consol
     assert all(isinstance(a, np.memmap) and a.mode == "r" for a in table.words)
 
 
+@pytest.mark.parametrize("consolidated", [False, True])
+@pytest.mark.parametrize("threads,split", [(0, 512), (1, 512), (16, 4), (7, 1)])
+def test_the_split_row_gather_returns_the_byte_wise_bytes(tmp_path, monkeypatch, consolidated, threads, split):
+    import torch
+
+    from tensorfold.families.qwen4_exp.cuda import exl3_pack
+
+    words, rows = 61, [37, 1, 90]
+    rng = np.random.default_rng(threads * 10 + split)
+    data = rng.integers(-2**15, 2**15, size=(sum(rows), words), dtype=np.int16)
+    pad = 3                                                        # an odd segment offset: unaligned int16 views
+    (tmp_path / "ngram.safetensors").write_bytes(bytes(pad) + data.tobytes())
+    entries = {f"t.shard_{i}.trellis": ("ngram.safetensors", pad + 2 * words * sum(rows[:i]),
+                                        pad + 2 * words * sum(rows[:i + 1]), "I16", [n, words]) for i, n in enumerate(rows)}
+    if consolidated:
+        entries = {"t.trellis": ("ngram.safetensors", pad, pad + data.nbytes, "I16", list(data.shape))}
+    tensors = {"t.head_bias": torch.zeros(4), "t.head_offsets": torch.zeros(2, dtype=torch.int64),
+               "t.head_vocab_sizes": torch.ones(2, dtype=torch.int64), "t.layer_multipliers": torch.ones(2)}
+    pk = SimpleNamespace(dir=tmp_path, entry=entries.__getitem__, get=tensors.__getitem__)
+    table = exl3_pack.NgramTable(pk, "t.", len(rows), "cpu")
+    monkeypatch.setattr(exl3_pack, "GATHER_THREADS", threads)
+    monkeypatch.setattr(exl3_pack, "GATHER_SPLIT", split)
+    for n in (0, 1, 5, 64, 257, 1000):
+        ids = rng.integers(0, sum(rows), size=(n // 4 + 1, 4))[: max(1, n // 4)] if n else np.zeros((0,), np.int64)
+        got = table.gather(ids)
+        assert got.dtype == np.int16 and got.shape == (ids.size, words)
+        assert got.tobytes() == data[np.asarray(ids).reshape(-1)].tobytes() == table._gather_bytes(
+            np.asarray(ids, dtype=np.int64).reshape(-1)).tobytes()
+
+
 @pytest.mark.parametrize("shape,dtype,end", [([0, 61], "I16", 0), ([3, 61], "F16", 366),
                                             ([3, 61], "I16", 364), ([3, 62], "I16", 372)])
 def test_ngram_table_rejects_invalid_packed_segments(tmp_path, shape, dtype, end):
