+    return load(name="tensorfold_exl3_experts_v10m", sources=srcs, extra_cuda_cflags=["-O3", "-lineinfo"],
                 verbose=False)
 
 
@@ -178,11 +178,40 @@ class Scratch:
         self.ids = torch.zeros((maxu,), dtype=torch.int32, device=device)
         self.count = torch.zeros((1,), dtype=torch.int32, device=device)
         self.route_done = torch.zeros((1,), dtype=torch.int32, device=device)   # route(): rows done (reset by the last)
+        self.split_rows = 0
+        if SPLIT and ex.count >= 2 and str(device) != "cpu":
+            self._split_buffers(ex, min(rows, ROUTE_ROWS), slots, device)
         self.members_buf = torch.full((maxu * rows,), -1, dtype=torch.int32, device=device)
         self.rows, self.slots, self.count_experts = rows, slots, ex.count
         self.device = device
         self._plan = None          # prompt windows: pairs grouped into items (``plan``), made on first use
 
+    def _split_buffers(self, ex: Exl3RoutedExperts, rows: int, slots: int, device) -> None:
+        """The split path's own buffers (``shared_part`` on ``side``; ``routed_split``'s epilogue counters)."""
+
+        D, I = ex.dims, ex.width
+        P = rows * slots
+        shared = ex.count - 1
+        self.split_rows = rows
+        self.side = torch.cuda.Stream(device=device)
+        self.xg_sh = torch.zeros((P, D), dtype=torch.float16, device=device)
+        self.xu_sh = torch.zeros((P, D), dtype=torch.float16, device=device)
+        self.xd_sh = torch.zeros((P, I), dtype=torch.float16, device=device)
+        self.z_sh = torch.zeros((2 * self.cfg_gu[2] * I * P,), dtype=torch.float32, device=device)
+        self.pick_sh = torch.full((rows, slots), -1, dtype=torch.int32, device=device)
+        self.pick_sh[:, slots - 1] = shared                       # the shared expert's slot, every row
+        self.ids_sh = torch.full((1,), shared, dtype=torch.int32, device=device)
+        self.cnt_sh = torch.ones((1,), dtype=torch.int32, device=device)
+        self.mem_sh = torch.tensor([r * 32 + slots - 1 for r in range(rows)], dtype=torch.int32, device=device)
+        mt = (rows + 15) // 16
+        self.counters_r = torch.zeros((min(P, ex.count) * (I // 128) * mt,), dtype=torch.int32, device=device)
+        self.counters_sh = torch.zeros(((I // 128) * mt,), dtype=torch.int32, device=device)
+        g, u, d = ex.gate_k2.tolist(), ex.up_k2.tolist(), ex.down_k2.tolist()
+        self.k2_r_gu = (min(g[:-1] + u[:-1]), max(g[:-1] + u[:-1])) if shared else (8, 8)
+        self.k2_r_d = (min(d[:-1]), max(d[:-1])) if shared else (8, 8)
+        self.k2_sh_gu = (min(g[-1], u[-1]), max(g[-1], u[-1]))
+        self.k2_sh_d = (d[-1], d[-1])
+
     def plan(self):
         """A prompt plan over this scratch's rows (tensorfold.cuda.experts' grouping: items of one expert's next pairs,
         pair order) with one more expert than the layer's, so skipped picks (== E) group apart and are skipped."""
@@ -278,6 +307,10 @@ ROUTE_FUSED = _ROUTE != "0"
 # -> 2. "single": all three in one grid (route_kernel; redoes each pair's top-k: measured slower, kept for the bench).
 ROUTE_SINGLE = _ROUTE == "single"
 ROUTE_ROWS = env_rows("TF_MOE_ROUTE_ROWS", 64)
+# TF_MOE_SPLIT=1 (default; 0 off): a decode window (route_ok, mul1, tiles (8, 4, 1)/(8, 4, 1, 1)) runs the shared
+# expert apart on a side stream beside the router (shared_part) and the routed experts with their epilogues fused into
+# the grouped kernels (route_split + routed_split): the same Y bits, two launches and the router's idle SMs fewer.
+SPLIT = env_choice("TF_MOE_SPLIT", "1") == "1"
 
 
 def route_ok(R: int, x: torch.Tensor, ex: Exl3RoutedExperts, s: Scratch, top_k: int, experts: int,
@@ -304,6 +337,58 @@ def route(logits: torch.Tensor, x: torch.Tensor, pick: torch.Tensor, wts: torch.
     _ext().rot_in(x, x.stride(0), pick, ex.suh_g, ex.suh_u, s.xg, s.xu, R, ex.dims, s.slots, ex.count, False)
 
 
+def split_ok(R: int, x: torch.Tensor, ex: Exl3RoutedExperts, s: Scratch, top_k: int, experts: int) -> bool:
+    """Whether a decode window takes the split path: the shared expert (the table's last, slot top_k) apart beside the
+    router, the routed experts with their epilogues fused (TF_MOE_SPLIT; the same bits as route + routed)."""
+
+    return (SPLIT and 0 < R <= s.split_rows and route_ok(R, x, ex, s, top_k, experts) and ex.cb == CB_MUL1
+            and ex.count == experts + 1 and tuple(s.cfg_gu[:2]) == (8, 4) and s.cfg_gu[3] == 1
+            and tuple(s.cfg_d) == (8, 4, 1, 1) and ex.width % 128 == 0 and ex.dims % 128 == 0)
+
+
+def shared_part(x: torch.Tensor, ex: Exl3RoutedExperts, s: Scratch, R: int, limit: float = math.inf,
+                act_mode: int = ACT_F32) -> None:
+    """The shared expert alone: rot_in, gate|up with its epilogue, down with its epilogue, into its rows of s.y (the
+    bits routed() gives that slot). Needs only x: the caller runs it on ``s.side`` beside the router."""
+
+    ext = _ext()
+    D, I, P = ex.dims, ex.width, R * s.slots
+    ext.rot_in(x, x.stride(0), s.pick_sh[:R], ex.suh_g, ex.suh_u, s.xg_sh, s.xu_sh, R, D, s.slots, ex.count, False)
+    mem = s.mem_sh[:R].view(1, R)
+    ext.grouped_epi(s.xg_sh, s.xu_sh, ex.gate_ptr, ex.up_ptr, ex.gate_k2, ex.up_k2, s.ids_sh, s.cnt_sh, mem, s.z_sh, 2,
+                    D, I, P, s.cfg_gu[2], s.slots, ex.cb, *s.k2_sh_gu, 1, s.counters_sh, ex.svh_g, ex.svh_u, ex.suh_d,
+                    s.xd_sh, s.y, float(limit), act_mode)
+    ext.grouped_epi(s.xd_sh, s.xd_sh, ex.down_ptr, ex.down_ptr, ex.down_k2, ex.down_k2, s.ids_sh, s.cnt_sh, mem, s.z_sh,
+                    1, I, D, P, 1, s.slots, ex.cb, *s.k2_sh_d, 2, s.counters_sh, ex.svh_d, ex.svh_d, ex.suh_d,
+                    s.xd_sh, s.y, float(limit), act_mode)
+
+
+def route_split(logits: torch.Tensor, x: torch.Tensor, pick: torch.Tensor, wts: torch.Tensor, ex: Exl3RoutedExperts,
+                s: Scratch, R: int, top_k: int, experts: int) -> None:
+    """route() with the shared expert out of the groups and out of rot_in (its slot still gets its pick and weight)."""
+
+    ids, members = s.window(R)
+    _ext().select_group(logits, pick, wts, ids, s.count, members, R, s.slots, experts, top_k, ex.count - 1)
+    _ext().rot_in(x, x.stride(0), pick, ex.suh_g, ex.suh_u, s.xg, s.xu, R, ex.dims, s.slots, ex.count - 1, False)
+
+
+def routed_split(x: torch.Tensor, pick: torch.Tensor, ex: Exl3RoutedExperts, s: Scratch, R: int,
+                 limit: float = math.inf, act_mode: int = ACT_F32) -> torch.Tensor:
+    """The routed experts of a route_split window: gate|up with gateup_epilogue fused, down with down_epilogue fused,
+    into their rows of s.y; with shared_part's rows, Y of every slot (routed()'s bits)."""
+
+    ext = _ext()
+    D, I, P = ex.dims, ex.width, R * s.slots
+    ids, members = s.window(R)
+    ext.grouped_epi(s.xg, s.xu, ex.gate_ptr, ex.up_ptr, ex.gate_k2, ex.up_k2, ids, s.count, members, s.z, 2, D, I, P,
+                    s.cfg_gu[2], s.slots, ex.cb, *s.k2_r_gu, 1, s.counters_r, ex.svh_g, ex.svh_u, ex.suh_d, s.xd, s.y,
+                    float(limit), act_mode)
+    ext.grouped_epi(s.xd, s.xd, ex.down_ptr, ex.down_ptr, ex.down_k2, ex.down_k2, ids, s.count, members, s.z, 1, I, D,
+                    P, 1, s.slots, ex.cb, *s.k2_r_d, 2, s.counters_r, ex.svh_d, ex.svh_d, ex.suh_d, s.xd, s.y,
+                    float(limit), act_mode)
+    return s.y[:P]
+
+
 def routed(x: torch.Tensor, pick: torch.Tensor, wts: torch.Tensor | None, ex: Exl3RoutedExperts, s: Scratch,
            out: torch.Tensor | None, R: int, limit: float = math.inf, act_mode: int = ACT_F32,
            group: bool = True, y_out: torch.Tensor | None = None, prepped: bool = False) -> torch.Tensor:
diff --git a/src/tensorfold/cuda/exl3/experts_grouped.cuh b/src/tensorfold/cuda/exl3/experts_grouped.cuh
index 405ac458..1de565ed 100644
--- a/src/tensorfold/cuda/exl3/experts_grouped.cuh
+++ b/src/tensorfold/cuda/exl3/experts_grouped.cuh
@@ -200,14 +200,46 @@ __host__ __device__ constexpr bool k2_supported(int k2) {
     return k2 >= 2 && k2 <= 16;
 }
 
-// Program (expert u, n block, split and member tile): up to 16 members times W_q over the split's K range; warps added in order.
-template <int CB, int NT, int W, int PF, int LO, int HI>
+// experts.cu's fwht128, 1 / sqrt(128) and bf16 rounding, for the fused epilogues below.
+__device__ __forceinline__ void fwht128g(float (&v)[4], int lane) {
+    float a = v[0] + v[1], b = v[0] - v[1], c = v[2] + v[3], d = v[2] - v[3];
+    v[0] = a + c; v[1] = b + d; v[2] = a - c; v[3] = b - d;
+#pragma unroll
+    for (int m = 1; m < 32; m <<= 1) {
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            float o = __shfl_xor_sync(0xffffffffu, v[j], m);
+            v[j] = (lane & m) ? o - v[j] : v[j] + o;
+        }
+    }
+}
+constexpr float HAD_SCALE_G = 0.08838834764831845f;
+__device__ __forceinline__ float bf16rg(float x) { return __bfloat162float(__float2bfloat16_rn(x)); }
+
+// Fused epilogues (decode windows). EPI 1, gate|up: the last of an (expert, 128-column block, member tile)'s mats * SK
+// programs runs gateup_epilogue_kernel's arithmetic for its rows and columns (xd). EPI 2, down with one split: the
+// warps' sums go through down_epilogue_kernel's arithmetic straight away (y, no Z).
+struct Epi {
+    int* counters;          // EPI 1: one a (expert slot, n block, member tile), left zero
+    const half* svh0;       // EPI 1: svh of gate; EPI 2: svh of down
+    const half* svh1;       // EPI 1: svh of up
+    const half* suh_d;      // EPI 1
+    half* xd;               // EPI 1: [P, N]
+    float* y;               // EPI 2: [P, N]
+    float limit;
+    int act;                // 0: GLM's bf16 roundings, 1: fp32
+};
+
+// Program (n block, expert u, split and member tile): up to 16 members times W_q over the split's K range; warps added
+// in order. An expert's n blocks are neighbours in the grid (launched together: its words stream in order). MR 8:
+// rows 0-7 of a member tile only (decode windows of at most 8 members), half the shared memory.
+template <int CB, int NT, int W, int PF, int LO, int HI, int EPI = 0, int MR = 16>
 __global__ void __launch_bounds__(W * 32) grouped_kernel(
     const half* __restrict__ X0, const half* __restrict__ X1, const int64_t* __restrict__ TP0,
     const int64_t* __restrict__ TP1, const int* __restrict__ K2_0, const int* __restrict__ K2_1,
     const int* __restrict__ uids, const int* __restrict__ ucount, const int* __restrict__ members,
-    float* __restrict__ Z, int K, int N, int P, int SK, int maxm, int slots) {
-    const int u = blockIdx.x;
+    float* __restrict__ Z, int K, int N, int P, int SK, int maxm, int slots, const Epi ep = Epi{}) {
+    const int u = blockIdx.y, nbk = blockIdx.x;
     if (u >= ucount[0]) return;
     const int MT = (maxm + 15) / 16;
     const int mtile = blockIdx.z % MT;
@@ -235,7 +267,7 @@ __global__ void __launch_bounds__(W * 32) grouped_kernel(
 
     const int per_split = KT / SK, per_warp = per_split / W;
     const int kt0 = split * per_split + warp * per_warp;
-    const int nt0 = blockIdx.y * NT;
+    const int nt0 = nbk * NT;
 
     float acc[NT][2][4];
 #pragma unroll
@@ -274,7 +306,7 @@ __global__ void __launch_bounds__(W * 32) grouped_kernel(
     }
 
     // warps' partial sums through shared memory, added in warp order
-    __shared__ float red[W][16][NT * 16];
+    __shared__ float red[W][MR][NT * 16];
 #pragma unroll
     for (int i = 0; i < NT; ++i)
 #pragma unroll
