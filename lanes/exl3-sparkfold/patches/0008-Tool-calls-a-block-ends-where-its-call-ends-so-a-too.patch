diff --git a/src/tensorfold/server/tools.py b/src/tensorfold/server/tools.py
index f8ea082..4616f81 100644
--- a/src/tensorfold/server/tools.py
+++ b/src/tensorfold/server/tools.py
@@ -86,6 +86,76 @@ def active_tool_specs(tools: Any, tool_choice: Any) -> list[dict[str, Any]]:
     return specs
 
 
+_CALL_OPEN_RE = re.compile(re.escape("<tool_call>"), re.IGNORECASE)
+_CALL_CLOSE_RE = re.compile(re.escape("</tool_call>"), re.IGNORECASE)
+_CLOSE_CANDIDATES = 4096     # closes one block examines per pass; past it the first close ends the block (the old rule)
+
+
+def _ends_like_a_call(text: str, start: int, at: int) -> bool:
+    """``text[start:at]`` ends where a finished call ends, white space aside: ``</function>`` or ``</parameter>`` (a
+    JSON body, one that starts with ``{``: ``}``)."""
+
+    end = at
+    while end > start and text[end - 1].isspace():
+        end -= 1
+    first = start
+    while first < end and text[first].isspace():
+        first += 1
+    if first < end and text[first] == "{":
+        return text[end - 1] == "}"
+    tail = text[max(start, end - len("</parameter>")):end].lower()
+    return tail.endswith("</function>") or tail.endswith("</parameter>")
+
+
+def tool_call_close(text: str, start: int, *, finished: bool = True) -> int:
+    """Where the ``<tool_call>`` block whose body starts at ``start`` ends: the index of its ``</tool_call>``, or -1.
+
+    The format has no escaping, so an argument can hold the text ``</tool_call>`` (a file about tool calls). A close
+    ends the block only where the call has ended, as vLLM's Qwen parser and veloGB10 0.7.4 read it: the text before it
+    ends with ``</function>`` or ``</parameter>`` (a JSON body: ``}``), and it does not close a ``<tool_call>`` the block
+    itself opened (a quoted complete block inside an argument is text). A finished reply then retries without that
+    debt (prose that mentions ``<tool_call>`` once owes nothing) and, when still no close qualifies, ends the block at
+    its first close, the old rule. A reply still streaming waits for more text instead (-1), so nothing past a quoted
+    close is shown early."""
+
+    closes = []
+    for m in _CALL_CLOSE_RE.finditer(text, start):
+        closes.append(m.start())
+        if len(closes) == _CLOSE_CANDIDATES:
+            break
+    if not closes:
+        return -1
+    opens = [m.start() for m in _CALL_OPEN_RE.finditer(text, start, closes[-1])]
+    owed, o = 0, 0
+    for at in closes:
+        while o < len(opens) and opens[o] < at:
+            owed, o = owed + 1, o + 1
+        if owed:
+            owed -= 1
+            continue
+        if _ends_like_a_call(text, start, at):
+            return at
+    if not finished:
+        return closes[0] if len(closes) == _CLOSE_CANDIDATES else -1
+    return next((at for at in closes if _ends_like_a_call(text, start, at)), closes[0])
+
+
+def tool_call_blocks(text: str) -> list[tuple[int, int, str]]:
+    """A finished reply's closed ``<tool_call>`` blocks under ``tool_call_close``: (start, end, body stripped)."""
+
+    out, pos = [], 0
+    while True:
+        m = _CALL_OPEN_RE.search(text, pos)
+        if m is None:
+            return out
+        close = tool_call_close(text, m.end())
+        if close < 0:
+            return out
+        end = close + len("</tool_call>")
+        out.append((m.start(), end, text[m.end():close].strip()))
+        pos = end
+
+
 _TOOL_CALL_BLOCK_RE = re.compile(
     r"<tool_call>\s*(.*?)\s*</tool_call>",
     re.IGNORECASE | re.DOTALL,
