+
+
+QUOTING = ("<tool_call>\n<function=run_notebook_cell>\n<parameter=cellId>\n#VSC-1\n</parameter>\n<parameter=filePath>\n"
+           "pattern = r\"<tool_call>(.*?)</tool_call>\"\n</parameter>\n</function>\n</tool_call>")
+
+
+@pytest.mark.parametrize("stream", [False, True])
+@pytest.mark.parametrize("parallel", [True, False])
+def test_an_argument_that_holds_a_close_tag_is_one_whole_call(tmp_path, stream, parallel) -> None:
+    engine = OneShotEngine(QUOTING)
+    with serving(app_for(tmp_path, engine)) as port:
+        status, raw = post(port, {**BODY, "stream": stream, "parallel_tool_calls": parallel})
+    assert status == 200, raw
+    if stream:
+        content, calls, finish = "", {}, None
+        for line in raw.splitlines():
+            if line.startswith("data: ") and line != "data: [DONE]":
+                choice = json.loads(line[6:])["choices"][0]
+                content += choice["delta"].get("content") or ""
+                for tc in choice["delta"].get("tool_calls") or []:
+                    c = calls.setdefault(tc["index"], ["", ""])
+                    c[0] += tc["function"].get("name") or ""
+                    c[1] += tc["function"].get("arguments") or ""
+                finish = choice.get("finish_reason") or finish
+        calls = [tuple(v) for _, v in sorted(calls.items())]
+    else:
+        choice = json.loads(raw)["choices"][0]
+        finish, content = choice["finish_reason"], choice["message"].get("content") or ""
+        calls = [(c["function"]["name"], c["function"]["arguments"]) for c in choice["message"].get("tool_calls") or []]
+    assert finish == "tool_calls" and content.strip() == "", (finish, content)
+    assert [c[0] for c in calls] == ["run_notebook_cell"]
+    assert json.loads(calls[0][1]) == {"cellId": "#VSC-1", "filePath": 'pattern = r"<tool_call>(.*?)</tool_call>"'}
diff --git a/tests/test_tool_block_end.py b/tests/test_tool_block_end.py
new file mode 100644
index 0000000..1f9083b
--- /dev/null
+++ b/tests/test_tool_block_end.py
@@ -0,0 +1,91 @@
+"""A </tool_call> inside an argument (a file about tool calls) is text: a block ends where its call ends, as vLLM's Qwen
+parser and veloGB10 0.7.4 read it, in the end parser, the streamed content and the single-call filter."""
+import json
+
+import pytest
+
+from tensorfold.cuda.reply_text import hide_tool_calls, parse_tool_calls
+from tensorfold.server.tool_policy import _ToolTextFilter
+from tensorfold.server.tools import tool_call_close
+
+TOOLS = [{"type": "function", "function": {"name": "write_file", "parameters": {"type": "object", "properties": {
+    "path": {"type": "string"}, "content": {"type": "string"}}}}}]
+
+
+def call(content: str, path: str = "parse.py") -> str:
+    return ("<tool_call>\n<function=write_file>\n<parameter=path>\n" + path + "\n</parameter>\n<parameter=content>\n"
+            + content + "\n</parameter>\n</function>\n</tool_call>")
+
+
+QUOTED_CLOSE = 'pattern = r"<tool_call>(.*?)</tool_call>"\nprint(pattern)'
+LONE_CLOSE = "the block ends with </tool_call> and nothing else"
+QUOTED_BLOCK = "Example:\n<tool_call>\n<function=f>\n<parameter=a>\n1\n</parameter>\n</function>\n</tool_call>\nDone."
+MENTION = "wrap every call in <tool_call> tags"
+
+
+def args(calls):
+    return [(c["function"]["name"], json.loads(c["function"]["arguments"])) for c in calls or []]
+
+
+@pytest.mark.parametrize("value", [QUOTED_CLOSE, LONE_CLOSE, MENTION])
+def test_a_value_that_quotes_the_tags_is_read_whole(value) -> None:
+    content, calls = parse_tool_calls(call(value), TOOLS)
+    assert content == "" and args(calls) == [("write_file", {"path": "parse.py", "content": value})]
+
+
+def test_a_quoted_complete_block_stays_inside_one_call() -> None:
+    """The block ends at the real close (no leftover markup as content); the VALUE still ends at the first
+    </parameter>, the value rule's known limit (veloGB10 0.7.4 leaves it too, behind opt-in flags)."""
+
+    content, calls = parse_tool_calls(call(QUOTED_BLOCK), TOOLS)
+    assert content == "" and args(calls) == [
+        ("write_file", {"path": "parse.py", "content": QUOTED_BLOCK[:QUOTED_BLOCK.index("\n</parameter>")]})]
+
+
+def test_before_the_fix_the_first_close_cut_the_call() -> None:
+    text = call(QUOTED_CLOSE)
+    start = text.index("<tool_call>") + len("<tool_call>")
+    assert tool_call_close(text, start) == text.rindex("</tool_call>") != text.index("</tool_call>")
+
+
+def test_two_real_calls_stay_two_and_prose_after_them_is_content() -> None:
+    text = call(QUOTED_CLOSE, "a.py") + "\n" + call("x = 1", "b.py") + "\nBoth written."
+    content, calls = parse_tool_calls(text, TOOLS)
+    assert args(calls) == [("write_file", {"path": "a.py", "content": QUOTED_CLOSE}),
+                           ("write_file", {"path": "b.py", "content": "x = 1"})]
+    assert content == "Both written."
+
+
+def test_a_block_without_a_function_close_ends_at_its_first_close_as_before() -> None:
+    text = "<tool_call>\n<function=write_file>\n<parameter=path>\nq\n</tool_call>\nafter"
+    content, calls = parse_tool_calls(text, TOOLS)
+    assert calls is None and content == text
+
+
+def test_an_unclosed_block_stays_text_as_before() -> None:
+    text = "<tool_call>\n<function=write_file>\n<parameter=path>\nq\n</parameter>\n</function>\n"
+    assert parse_tool_calls(text, TOOLS) == (text.strip(), None)
+
+
+def test_a_json_body_ends_at_its_closing_brace() -> None:
+    text = '<tool_call>\n{"name": "write_file", "arguments": {"path": "p", "content": "</tool_call>"}}\n</tool_call>'
+    content, calls = parse_tool_calls(text, TOOLS)
+    assert content == "" and args(calls) == [("write_file", {"path": "p", "content": "</tool_call>"})]
+
+
+@pytest.mark.parametrize("value", [QUOTED_CLOSE, LONE_CLOSE, QUOTED_BLOCK, MENTION])
+def test_streamed_content_never_shows_a_value(value) -> None:
+    text = "Writing it.\n" + call(value) + "\nDone."
+    final = hide_tool_calls(text, finished=True)
+    assert final == "Writing it.\nDone." or final == "Writing it.\n\nDone."
+    for n in range(len(text) + 1):
+        shown = hide_tool_calls(text[:n], finished=False)
+        assert final.startswith(shown), (n, shown)
+
+
+@pytest.mark.parametrize("value", [QUOTED_CLOSE, LONE_CLOSE, QUOTED_BLOCK])
+def test_the_single_call_filter_hides_the_whole_block(value) -> None:
+    text = "Writing it.\n" + call(value) + "\nDone."
+    f = _ToolTextFilter()
+    shown = "".join(f.feed(ch) for ch in text) + f.finish()
+    assert shown == "Writing it.\n\nDone."
