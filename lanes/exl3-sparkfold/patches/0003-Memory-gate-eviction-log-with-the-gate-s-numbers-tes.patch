+"""The memory gate says why it evicted a kept conversation (the numbers a floor change would be judged by)."""
+from types import SimpleNamespace
+
+from tensorfold.cuda.memory_gate import MemoryGate
+from tensorfold.families.qwen4_exp.cuda.multi import MultiDecoder
+
+GIB = 2**30
+
+
+def test_eviction_note_names_the_gate_numbers(capsys) -> None:
+    gate = MemoryGate(33 * GIB, 2 * GIB, live=lambda: int(1.5 * GIB))
+    gate.held = 9 * GIB
+    me = SimpleNamespace(planning=False, memory_gate=gate)
+    MultiDecoder._evict_note(me, "a 144150-token kept state", int(0.2 * GIB))
+    out = capsys.readouterr().out
+    assert "evicted a 144150-token kept state to grow a cache by 0.20 GiB" in out
+    assert "free over the floor 1.5 GiB" in out and "plus 2.0 GiB" in out and "9.0 of 33.0 GiB" in out
+    assert "TENSORFOLD_MEMORY_RESERVE_GIB" in out
+
+
+def test_planning_copies_stay_silent(capsys) -> None:
+    me = SimpleNamespace(planning=True, memory_gate=MemoryGate(GIB, GIB))
+    MultiDecoder._evict_note(me, "x", 1)
+    assert capsys.readouterr().out == ""
+
+
+def test_gate_without_a_live_reading_still_prints(capsys) -> None:
+    me = SimpleNamespace(planning=False, memory_gate=MemoryGate(4 * GIB, 2 * GIB))
+    MultiDecoder._evict_note(me, "the lone-stream graph slot's caches", GIB)
+    assert "free over the floor n/a" in capsys.readouterr().out
