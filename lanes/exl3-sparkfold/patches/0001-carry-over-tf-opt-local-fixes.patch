+# Qwen's reserved strings: a request's TEXT that quotes one (a fetched page, a source file about the tokenizer or the chat template)
+# would be tokenized to the real token. A media marker miscounts the image markers (refused) or puts a media token with no media into the
+# prompt; <|im_start|>/<|im_end|> let pasted text open a turn of its own (injection) and a quote of one ends the reply; a </think> quoted
+# in the reasoning ends it there and the rest of the thinking leaks into the answer (the DeepSeek image v8 escape did this for the tags);
+# a quoted <tool_call> block copied into the reply is parsed as a real call. Each is written ``<`` + U+200B + the rest: plain text.
+_RESERVED = tuple("<|" + n + "|>" for n in ("image_pad", "video_pad", "vision_start", "vision_end", "vision_pad", "im_start", "im_end",
+                                            "endoftext")) + ("<think>", "</think>")
+_TOOL_TAGS = ("<tool_call>", "</tool_call>", "<tool_response>", "</tool_response>")
+_ESCAPED = tuple("<\u200b" + r[1:] for r in _RESERVED)
+_ESCAPED_TOOLS = tuple("<\u200b" + r[1:] for r in _TOOL_TAGS)
+_RESERVED_RE = re.compile("|".join(re.escape(r) for r in _RESERVED + _TOOL_TAGS))
+_ESCAPED_RE = re.compile("|".join(re.escape(e) for e in _ESCAPED))
+_ESCAPED_ALL_RE = re.compile("|".join(re.escape(e) for e in _ESCAPED + _ESCAPED_TOOLS))
+
+
+def defuse_special_tokens(value):
+    """``value`` (messages, tools) with every literal reserved string in its strings written ``<`` + U+200B + the rest: plain text to the
+    tokenizer and to the reply parsers. Unchanged parts are returned as they are, so a large image payload is only scanned."""
+    if isinstance(value, str):
+        return _RESERVED_RE.sub(lambda m: "<\u200b" + m.group(0)[1:], value) if "<" in value else value
+    if isinstance(value, list):
+        out = [defuse_special_tokens(v) for v in value]
+        return out if any(a is not b for a, b in zip(out, value)) else value
+    if isinstance(value, dict):
+        out = {k: defuse_special_tokens(v) for k, v in value.items()}
+        return out if any(out[k] is not value[k] for k in value) else value
+    return value
+
+
+def restore_special_tokens(text: str, finished: bool, tools: bool = True) -> str:
+    """The model's text with the escaped strings of ``defuse_special_tokens`` written back as the strings it was shown (a quote of a file
+    stays exact). Three steps: after the reasoning/answer split (a restored ``</think>`` would split there) with ``tools=False`` on text the
+    tool-call parsers still read (a restored ``<tool_call>`` would be a call), then ``tools=True`` on what is shown or sent. Not finished: a
+    tail that may still grow into an escaped string is held back, so the result only ever extends."""
+    if "\u200b" not in text:
+        return text
+    escaped = _ESCAPED + _ESCAPED_TOOLS if tools else _ESCAPED
+    text = (_ESCAPED_ALL_RE if tools else _ESCAPED_RE).sub(lambda m: "<" + m.group(0)[2:], text)
+    if not finished:
+        for n in range(min(len(text), max(map(len, escaped)) - 1), 1, -1):
+            tail = text[-n:]
+            if tail.startswith("<\u200b") and any(e.startswith(tail) for e in escaped):
+                return text[:-n]
+    return text
+
+
+class RestoredCallDeltas:
+    """The argument fragments of streamed tool calls with the escaped strings written back; the fragments of a call are cumulative, so a
+    string split across two of them is held until the next one (every call ends in ``}``, which flushes it)."""
+
+    def __init__(self) -> None:
+        self.text: dict[int, str] = {}
+        self.sent: dict[int, int] = {}
+
+    def __call__(self, delta: dict):
+        call = (delta.get("tool_calls") or [None])[0]
+        fragment = ((call or {}).get("function") or {}).get("arguments")
+        if not fragment:
+            return delta
+        i = call["index"]
+        self.text[i] = self.text.get(i, "") + fragment
+        shown = restore_special_tokens(self.text[i], False)
+        done = self.sent.get(i, 0)           # a held-back tail can make ``shown`` shorter than what went out (a bare "<" does)
+        new, self.sent[i] = shown[done:], max(done, len(shown))
+        if not new:
+            return None
+        return {**delta, "tool_calls": [{**call, "function": {**call["function"], "arguments": new}}]}
+
