index 0000000..155e7df
--- /dev/null
+++ b/tests/test_cuda_server_tool_slips.py
@@ -0,0 +1,79 @@
+"""Through the whole CUDA server: a reply that opens <tool_call> twice, or calls <function=function>, reaches the client as a tool call
+(streamed or not), not as raw text that ends the agent's turn."""
+import json
+
+import pytest
+
+pytest.importorskip("jinja2")
+
+from test_cuda_server_disconnect import PacedEngine, app_for, post, serving
+
+TOOLS = [{"type": "function", "function": {"name": "run_notebook_cell", "parameters": {"type": "object", "properties": {
+    "cellId": {"type": "string"}, "filePath": {"type": "string"}}}}}]
+CELL = "<function=run_notebook_cell>\n<parameter=cellId>\n#VSC-1\n</parameter>\n<parameter=filePath>\n/x/nb.ipynb\n</parameter>\n</function>"
+GOOD = "<tool_call>\n" + CELL + "\n</tool_call>"
+DOUBLED = "<tool_call>\n<tool_call>\n" + CELL + "\n</tool_call>"
+UNKNOWN = "<tool_call>\n<function=function>\n</function>\n</tool_call>"
+
+
+class OneShotEngine(PacedEngine):
+    """Emits ``text`` token by token, then the end token, and returns (the paced engine would go on with "x" to max_tokens)."""
+
+    def generate(self, prompt, max_tokens, sampling, on_tokens, draft=True):
+        for token in [ord(c) for c in self.text] + [0]:
+            if on_tokens([token]):
+                break
+        return {"rounds": len(self.text) + 1}
+
+
+BODY = {"messages": [{"role": "user", "content": "run it"}], "tools": TOOLS, "max_tokens": 400}
+
+
+def reply(tmp_path, text, stream):
+    engine = OneShotEngine(text)
+    with serving(app_for(tmp_path, engine)) as port:
+        status, raw = post(port, {**BODY, "stream": stream})
+    assert status == 200, raw
+    if not stream:
+        choice = json.loads(raw)["choices"][0]
+        return choice["finish_reason"], choice["message"].get("content") or "", [
+            (c["function"]["name"], c["function"]["arguments"]) for c in choice["message"].get("tool_calls") or []]
+    content, calls, finish = "", {}, None
+    for line in raw.splitlines():
+        if line.startswith("data: ") and line != "data: [DONE]":
+            choice = json.loads(line[6:])["choices"][0]
+            content += choice["delta"].get("content") or ""
+            for tc in choice["delta"].get("tool_calls") or []:
+                call = calls.setdefault(tc["index"], ["", ""])
+                call[0] += tc["function"].get("name") or ""
+                call[1] += tc["function"].get("arguments") or ""
+            finish = choice.get("finish_reason") or finish
+    return finish, content, [tuple(v) for _, v in sorted(calls.items())]
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_a_single_call_is_unchanged(tmp_path, stream) -> None:
+    finish, content, calls = reply(tmp_path, GOOD, stream)
+    assert finish == "tool_calls" and content.strip() == "" and [c[0] for c in calls] == ["run_notebook_cell"]
+    assert json.loads(calls[0][1]) == {"cellId": "#VSC-1", "filePath": "/x/nb.ipynb"}
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_a_doubled_opener_is_still_one_call(tmp_path, stream) -> None:
+    finish, content, calls = reply(tmp_path, DOUBLED, stream)
+    assert finish == "tool_calls" and "<tool_call>" not in content and "<function=" not in content
+    assert [c[0] for c in calls] == ["run_notebook_cell"]
+    assert json.loads(calls[0][1]) == {"cellId": "#VSC-1", "filePath": "/x/nb.ipynb"}
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_a_call_to_an_undeclared_name_goes_to_the_client(tmp_path, stream) -> None:
+    finish, content, calls = reply(tmp_path, UNKNOWN, stream)
+    assert finish == "tool_calls" and "<function=" not in content
+    assert [(c[0], c[1]) for c in calls] == [("function", "{}")]
+
+
+@pytest.mark.parametrize("stream", [False, True])
+def test_prose_that_mentions_the_tag_is_still_content(tmp_path, stream) -> None:
+    finish, content, calls = reply(tmp_path, "Use the <tool_call> tag to call tools.", stream)
+    assert finish == "stop" and not calls and "<tool_call>" in content
