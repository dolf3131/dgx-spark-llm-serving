+"""Two slips a model made in agent turns (10-09): ``<tool_call>`` opened twice in a row, and ``<function=function>`` (a name no tool declares).
+Both used to reach the client as raw text and end the turn."""
+import json
+
+from tensorfold.cuda.reply_text import collapse_call_openers, hide_tool_calls, parse_tool_calls
+from tensorfold.engine.tool_draft import ToolCallStreamer
+
+TOOLS = [{"type": "function", "function": {"name": "run_notebook_cell", "parameters": {"type": "object", "properties": {
+    "cellId": {"type": "string"}, "filePath": {"type": "string"}, "reason": {"type": "string"}}}}},
+    {"type": "function", "function": {"name": "get_weather", "parameters": {"type": "object", "properties": {"city": {"type": "string"}}}}}]
+CELL = ("<function=run_notebook_cell>\n<parameter=cellId>\n#VSC-8918ca1a\n</parameter>\n<parameter=filePath>\n/Users/x/nb.ipynb\n</parameter>\n"
+        "<parameter=reason>\n매개변수 회로 실행 확인\n</parameter>\n</function>")
+GOOD = "<tool_call>\n" + CELL + "\n</tool_call>"
+DOUBLED = "<tool_call>\n<tool_call>\n" + CELL + "\n</tool_call>"
+UNKNOWN = "<tool_call>\n<function=function>\n</function>\n</tool_call>"
+
+
+def names(calls):
+    return [c["function"]["name"] for c in calls or []]
+
+
+def test_a_doubled_opener_is_read_as_one_call() -> None:
+    assert parse_tool_calls(DOUBLED, TOOLS)[1] is None, "the parser alone still refuses it"
+    content, calls = parse_tool_calls(collapse_call_openers(DOUBLED), TOOLS)
+    assert content == "" and names(calls) == ["run_notebook_cell"]
+    assert json.loads(calls[0]["function"]["arguments"]) == {"cellId": "#VSC-8918ca1a", "filePath": "/Users/x/nb.ipynb",
+                                                             "reason": "매개변수 회로 실행 확인"}
+    assert hide_tool_calls(collapse_call_openers(DOUBLED), finished=True) == ""
+
+
+def test_other_text_is_not_touched_by_the_collapse() -> None:
+    two_calls = GOOD + "\n" + GOOD
+    assert collapse_call_openers(two_calls) == two_calls and collapse_call_openers(GOOD) == GOOD
+    assert collapse_call_openers("write <tool_call> then stop") == "write <tool_call> then stop"
+    assert collapse_call_openers("<TOOL_CALL>  <tool_call>x") == "<tool_call>\nx"
+
+
+def test_streamed_prefixes_of_a_doubled_opener_end_in_one_clean_call() -> None:
+    streamer, args = ToolCallStreamer(TOOLS), ""
+    for n in range(1, len(DOUBLED) + 1):           # the server feeds the collapsed text of every growing prefix
+        for delta in streamer.feed(collapse_call_openers(DOUBLED[:n])):
+            args += delta["tool_calls"][0]["function"].get("arguments") or ""
+    assert streamer.state == "outside" and streamer.streamed
+    assert json.loads(args)["cellId"] == "#VSC-8918ca1a"
+
+
+def test_an_undeclared_name_comes_back_as_a_call_only_when_asked() -> None:
+    content, calls = parse_tool_calls(UNKNOWN, TOOLS)
+    assert calls is None and "<function=function>" in content, "the default keeps the old behaviour"
+    content, calls = parse_tool_calls(UNKNOWN, TOOLS, keep_unknown=True)
+    assert content == "" and names(calls) == ["function"] and calls[0]["function"]["arguments"] == "{}"
+    assert parse_tool_calls(UNKNOWN, TOOLS, max_calls=1, keep_unknown=True)[1] is None, "single-call replies are unchanged"
+
+
+def test_declared_and_undeclared_calls_keep_their_order() -> None:
+    text = GOOD + "\n" + UNKNOWN
+    content, calls = parse_tool_calls(text, TOOLS, keep_unknown=True)
+    assert content == "" and names(calls) == ["run_notebook_cell", "function"]
+    content, calls = parse_tool_calls(UNKNOWN + "\n" + GOOD, TOOLS, keep_unknown=True)
+    assert names(calls) == ["function", "run_notebook_cell"]
+
+
+def test_text_that_is_not_a_call_stays_content_even_with_keep_unknown() -> None:
+    for text in ("<tool_call>not a call</tool_call>", "<tool_call>{}</tool_call>", "no tools here <function=x>"):
+        content, calls = parse_tool_calls(text, TOOLS, keep_unknown=True)
+        assert calls is None and content == text, text
