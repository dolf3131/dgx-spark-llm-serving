@@ -0,0 +1,105 @@
+"""TF_SPILL_DIR on the real MultiDecoder (tiny model): a conversation the pool or the memory gate would drop is written to disk, and its next turn
+reads it back; the reply equals the one a fresh prefill gives, token for token, with the same cached count a kept state would have given."""
+
+import numpy as np
+import pytest
+import torch
+
+if not torch.cuda.is_available():
+    pytest.skip("CUDA only", allow_module_level=True)
+
+from test_flashnext_forward import V, _model  # noqa: E402
+from test_flashnext_L7 import _ref, _run  # noqa: E402
+
+from tensorfold.engine.exact_sampling import Sampling  # noqa: E402
+from tensorfold.families.qwen4_exp.cuda import prefixes, spill  # noqa: E402
+from tensorfold.families.qwen4_exp.cuda.multi import MultiDecoder  # noqa: E402
+
+SMP = Sampling(seed=5, top_k=20, top_p=0.95)
+
+
+def conv(j: int, n: int):
+    return [(11 * i + 5 * j + 3) % (V - 1) + 1 for i in range(n)]
+
+
+def decoder(w, tmp_path, slots=2, kv="bf16", low=8, log=None):
+    dec = MultiDecoder(w, slots=slots, capacity=1024, depth=3, confidence=0.3, kv_dtype=kv, graphs=True, keep=8)
+    store = spill.SpillStore(tmp_path / "spill", 1 << 30, low, "test", log=log or (lambda *a, **k: None))
+    dec.spill = store
+    return dec, store
+
+
+@pytest.mark.parametrize("kv", ["bf16", "int8"])
+def test_a_conversation_pushed_out_of_the_pool_comes_back_from_disk_with_its_bits(tmp_path, kv):
+    w = _model()
+    dec, store = decoder(w, tmp_path, slots=2, kv=kv)
+    first = conv(0, 40)
+    a = _run(dec, first, 12, SMP)
+    assert a.out == _ref(w, first, 12, SMP, kv)
+    for j in (1, 2, 3):                                        # more conversations than slots: the oldest are taken over
+        _run(dec, conv(j, 30 + j), 6, SMP)
+    assert store.saved >= 1 and any(e.n == len(first) - 1 or e.n >= 30 for e in store.entries.values())
+    # the second turn of conversation 0: its first prompt, its reply and one more question
+    nxt = first + a.out + [101, 102, 103, 104]
+    before = store.loaded
+    b = _run(dec, nxt, 12, SMP)
+    assert store.loaded == before + 1, "the turn was read back from disk"
+    assert b.cached >= len(first) - 1, f"resumed from the stored state, not from zero (cached {b.cached})"
+    assert b.out == _ref(w, nxt, 12, SMP, kv), "a state read back from disk gives the replies a fresh prefill gives"
+
+
+def test_without_a_store_the_same_turn_prefills_from_zero(tmp_path):
+    w = _model()
+    dec, store = decoder(w, tmp_path, slots=2)
+    dec.spill = None
+    first = conv(0, 40)
+    a = _run(dec, first, 12, SMP)
+    for j in (1, 2, 3):
+        _run(dec, conv(j, 30 + j), 6, SMP)
+    b = _run(dec, first + a.out + [101, 102], 12, SMP)
+    assert b.cached == 0 and b.out == _ref(w, first + a.out + [101, 102], 12, SMP)
+
+
+def test_the_memory_gate_eviction_writes_the_state_too(tmp_path, monkeypatch):
+    w = _model()
+    dec, store = decoder(w, tmp_path, slots=3)
+    first = conv(0, 40)
+    a = _run(dec, first, 8, SMP)
+    victim = next(k[1] for k in dec.kept if len(k[0]) == max(len(x[0]) for x in dec.kept))
+    assert dec._evict_kept(dec.free[0] if dec.free else victim, protect=None) in (True, False)
+    assert store.saved >= 1, "the gate's eviction path goes through spill_slot"
+
+
+def test_a_failed_read_falls_back_to_a_fresh_prefill_and_forgets_the_file(tmp_path):
+    w = _model()
+    dec, store = decoder(w, tmp_path, slots=2)
+    first = conv(0, 40)
+    a = _run(dec, first, 8, SMP)
+    for j in (1, 2, 3):
+        _run(dec, conv(j, 30 + j), 6, SMP)
+    assert store.entries
+    entry = max(store.entries.values(), key=lambda e: e.n)
+    with open(entry.path, "r+b") as f:                         # truncate it: the read must fail, not return garbage
+        f.truncate(8192)
+    nxt = first + a.out + [101, 102]
+    b = _run(dec, nxt, 12, SMP)
+    assert b.out == _ref(w, nxt, 12, SMP) and b.cached == 0
+    assert entry.key not in store.entries and not entry.path.exists()
+    c = _run(dec, conv(5, 31), 4, SMP)                         # and the decoder is still sound
+    assert c.out == _ref(w, conv(5, 31), 4, SMP)
+
+
+def test_states_survive_a_restart_of_the_store(tmp_path):
+    w = _model()
+    dec, store = decoder(w, tmp_path, slots=2)
+    first = conv(0, 40)
+    a = _run(dec, first, 12, SMP)
+    for j in (1, 2, 3):
+        _run(dec, conv(j, 30 + j), 6, SMP)
+    n = len(store.entries)
+    assert n >= 1
+    again, store2 = decoder(w, tmp_path, slots=2)             # a new process: a new decoder, the same directory
+    assert len(store2.entries) == n
+    nxt = first + a.out + [101, 102, 103]
+    b = _run(again, nxt, 12, SMP)
+    assert store2.loaded == 1 and b.cached >= len(first) - 1 and b.out == _ref(w, nxt, 12, SMP)
diff --git a/tests/test_flashnext_spill_file.py b/tests/test_flashnext_spill_file.py
new file mode 100644
index 0000000..bc571e7
--- /dev/null
+++ b/tests/test_flashnext_spill_file.py
@@ -0,0 +1,183 @@
+"""SpillStore: a kept state written to disk reads back bit for bit into another slot; the directory rules (cap, supersede, signature)."""
+import os
+import time
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+
+from tensorfold.families.qwen4_exp.cuda import kvcache, spill
+
+CAP, HEADS, DIM, IDX, RATIO, LAYERS, NV, DV, DK, CONV, CONVDIM, WIDE = 64, 2, 32, 16, 4, 3, 4, 8, 8, 4, 12, 24
+
+
+def make_state(seed: int = 0, kv: str = "int8", mtp: bool = True):
+    g = torch.Generator().manual_seed(seed)
+
+    def rnd(t):
+        if t.dtype in (torch.int8, torch.uint8):
+            t.copy_(torch.randint(-100, 100, t.shape, generator=g).to(t.dtype))
+        else:
+            t.copy_(torch.randn(t.shape, generator=g).to(t.dtype))
+        return t
+
+    st = SimpleNamespace(ratio=RATIO, pos=0, image_positions=None)
+    st.kc = [kvcache.KVCache(CAP, HEADS, DIM, "cpu", kv) for _ in range(LAYERS)]
+    for c in st.kc:
+        for t in (c.k, c.v, c.ks, c.vs):
+            rnd(t)
+    st.ikc = [rnd(torch.zeros((CAP, IDX), dtype=torch.bfloat16)) for _ in range(LAYERS)]
+    st.pooled = [rnd(torch.zeros((CAP // RATIO, IDX), dtype=torch.bfloat16)) for _ in range(LAYERS)]
+    if mtp:
+        st.mtp_kc = kvcache.KVCache(CAP, HEADS, DIM, "cpu", kv)
+        for t in (st.mtp_kc.k, st.mtp_kc.v, st.mtp_kc.ks, st.mtp_kc.vs):
+            rnd(t)
+        st.mtp_ikc = rnd(torch.zeros((CAP, IDX), dtype=torch.bfloat16))
+        st.mtp_pooled = rnd(torch.zeros((CAP // RATIO, IDX), dtype=torch.bfloat16))
+    st.rec = rnd(torch.zeros((2, LAYERS, NV, DV, DK), dtype=torch.float32))
+    st.conv = rnd(torch.zeros((LAYERS, CONV - 1, CONVDIM), dtype=torch.bfloat16))
+    st.ple_tail = rnd(torch.zeros((6, WIDE), dtype=torch.bfloat16))
+    return st, g
+
+
+def snapshot(st, pos: int, mtp_len: int, g):
+    return {"pos": pos, "rec": st.rec[0].clone(), "conv": st.conv.clone(), "ple_tail": st.ple_tail.clone(),
+            "ple_history": np.arange(5, dtype=np.int64) + pos, "mtp_len": mtp_len, "mtp_head": 1}
+
+
+def store(tmp_path, limit_gib: float = 1.0, low: int = 1024, sig: str = "sig"):
+    return spill.SpillStore(tmp_path / "spill", int(limit_gib * spill.GIB), low, sig, log=lambda *a, **k: None)
+
+
+def ids_of(n: int, seed: int = 1):
+    return list(np.random.default_rng(seed).integers(0, 200000, n))
+
+
+@pytest.mark.parametrize("kv", ["int8", "bf16"])
+def test_a_state_reads_back_bit_for_bit(tmp_path, kv) -> None:
+    src, g = make_state(3, kv)
+    pos, mtp_len = 40, 39
+    src.pos = pos
+    ids = ids_of(pos)
+    snap = snapshot(src, pos, mtp_len, g)
+    tail = torch.randn((1, WIDE), generator=g).to(torch.bfloat16)
+    s = store(tmp_path, low=1)
+    assert s.saved == 0 and s.save(src, ids, snap, tail) and s.saved == 1
+    dst, _ = make_state(99, kv)                           # a slot holding other bytes
+    entry = s.find(ids + [7, 8, 9])
+    assert entry is not None and entry.n == pos
+    resume = s.load(entry, dst)
+    for i in range(LAYERS):
+        assert torch.equal(dst.kc[i].k[:pos], src.kc[i].k[:pos]) and torch.equal(dst.kc[i].v[:pos], src.kc[i].v[:pos])
+        if kv != "bf16":
+            assert torch.equal(dst.kc[i].ks[:pos], src.kc[i].ks[:pos]) and torch.equal(dst.kc[i].vs[:pos], src.kc[i].vs[:pos])
+        assert torch.equal(dst.ikc[i][:pos], src.ikc[i][:pos])
+        assert torch.equal(dst.pooled[i][:pos // RATIO], src.pooled[i][:pos // RATIO])
+    assert torch.equal(dst.mtp_kc.k[:mtp_len], src.mtp_kc.k[:mtp_len]) and torch.equal(dst.mtp_ikc[:mtp_len], src.mtp_ikc[:mtp_len])
+    assert torch.equal(dst.mtp_pooled[:mtp_len // RATIO], src.mtp_pooled[:mtp_len // RATIO])
+    state = resume["state"]
+    assert state["pos"] == pos and state["mtp_len"] == mtp_len and state["mtp_head"] == 1
+    assert torch.equal(state["rec"], snap["rec"]) and torch.equal(state["conv"], snap["conv"]) and torch.equal(state["ple_tail"], snap["ple_tail"])
+    assert state["ple_history"].dtype == np.int64 and (state["ple_history"] == snap["ple_history"]).all()
+    assert torch.equal(resume["tail"], tail)
+    assert not torch.equal(dst.kc[0].k[pos:], src.kc[0].k[pos:]), "rows past the position are not part of the state"
+
+
+def test_find_wants_a_prompt_that_extends_the_stored_ids(tmp_path) -> None:
+    src, g = make_state(1)
+    src.pos = 2000
+    ids = ids_of(2000)
+    s = store(tmp_path)
+    assert s.save(src, ids, snapshot(src, 2000, 1999, g), None)
+    assert s.find(ids) is None, "the same prompt again is not an extension (a kept end resumes one token before its prompt's end)"
+    assert s.find(ids[:-1] + [1]) is None
+    assert s.find(ids + [5]) is not None
+    other = ids_of(2000, seed=2)
+    assert s.find(other + [5]) is None
+
+
+def test_short_states_and_images_are_not_written(tmp_path) -> None:
+    src, g = make_state(1)
+    src.pos = 500
+    s = store(tmp_path, low=1024)
+    assert not s.save(src, ids_of(500), snapshot(src, 500, 499, g), None)
+    src.pos = 2000
+    src.image_positions = [1]
+    assert not s.save(src, ids_of(2000), snapshot(src, 2000, 1999, g), None)
+    assert not s.entries and not list((tmp_path / "spill").glob("*"))
+
+
+def test_a_longer_state_supersedes_the_shorter_one_and_the_cap_drops_the_oldest(tmp_path) -> None:
+    src, g = make_state(1)
+    s = store(tmp_path)
+    a = ids_of(2000)
+    src.pos = 2000
+    assert s.save(src, a, snapshot(src, 2000, 1999, g), None)
+    b = a + ids_of(40, seed=5)
+    src.pos = 2040
+    assert s.save(src, b, snapshot(src, 2040, 2039, g), None)
+    assert len(s.entries) == 1 and next(iter(s.entries.values())).n == 2040
+    one = next(iter(s.entries.values())).nbytes
+    small = store(tmp_path / "cap", limit_gib=one * 2.5 / spill.GIB if one * 2.5 / spill.GIB >= 0.5 else 0.5)
+    small.limit = int(one * 2.5)
+    for k in range(4):
+        src.pos = 2000
+        assert small.save(src, ids_of(2000, seed=10 + k), snapshot(src, 2000, 1999, g), None)
+        time.sleep(0.02)
+    assert len(small.entries) == 2 and small.total() <= small.limit
+    assert {e.ids[0] for e in small.entries.values()} == {ids_of(2000, seed=12)[0], ids_of(2000, seed=13)[0]}, "least recently used go first"
+
+
+def test_the_same_state_is_not_written_twice_and_a_read_makes_it_recent(tmp_path) -> None:
+    src, g = make_state(1)
+    src.pos = 2000
+    ids = ids_of(2000)
+    s = store(tmp_path)
+    assert s.save(src, ids, snapshot(src, 2000, 1999, g), None) and not s.save(src, ids, snapshot(src, 2000, 1999, g), None)
+    assert s.saved == 1
+
+
+def test_a_restart_adopts_matching_files_and_deletes_the_rest(tmp_path) -> None:
+    src, g = make_state(1)
+    src.pos = 2000
+    ids = ids_of(2000)
+    s = store(tmp_path, sig="A")
+    assert s.save(src, ids, snapshot(src, 2000, 1999, g), None)
+    (tmp_path / "spill" / "stray.tmp").write_bytes(b"x")
+    (tmp_path / "spill" / "junk.spill").write_bytes(b"not a spill file")
+    again = store(tmp_path, sig="A")
+    assert len(again.entries) == 1 and again.find(ids + [1]) is not None
+    assert sorted(p.name for p in (tmp_path / "spill").glob("*")) == [f"{next(iter(again.entries))}.spill"]
+    other = store(tmp_path, sig="B")
+    assert not other.entries and not list((tmp_path / "spill").glob("*")), "another model or numerics: nothing is reused"
+
+
+def test_files_and_directory_are_private(tmp_path) -> None:
+    src, g = make_state(1)
+    src.pos = 2000
+    s = store(tmp_path)
+    assert s.save(src, ids_of(2000), snapshot(src, 2000, 1999, g), None)
+    assert (os.stat(tmp_path / "spill").st_mode & 0o777) == 0o700
+    assert all((os.stat(p).st_mode & 0o777) == 0o600 for p in (tmp_path / "spill").glob("*.spill"))
+
+
+def test_a_slot_with_other_geometry_refuses_the_read(tmp_path) -> None:
+    src, g = make_state(1)
+    src.pos = 2000
+    ids = ids_of(2000)
+    s = store(tmp_path)
+    assert s.save(src, ids, snapshot(src, 2000, 1999, g), None)
+    wrong, _ = make_state(1, "bf16")
+    with pytest.raises(ValueError):
+        s.load(s.find(ids + [1]), wrong)
+
+
+def test_env_settings() -> None:
+    assert spill.env_settings({}) is None and spill.env_settings({"TF_SPILL_DIR": "off"}) is None
+    d, cap, low = spill.env_settings({"TF_SPILL_DIR": "/x", "TF_SPILL_GIB": "8", "TF_SPILL_MIN": "4096"})
+    assert str(d) == "/x" and cap == 8 * spill.GIB and low == 4096
+    for bad in ({"TF_SPILL_DIR": "/x", "TF_SPILL_GIB": "many"}, {"TF_SPILL_DIR": "/x", "TF_SPILL_GIB": "0"},
+                {"TF_SPILL_DIR": "/x", "TF_SPILL_MIN": "10"}, {"TF_SPILL_DIR": "/x", "TF_SPILL_MIN": "x"}):
+        with pytest.raises(ValueError):
+            spill.env_settings(bad)
