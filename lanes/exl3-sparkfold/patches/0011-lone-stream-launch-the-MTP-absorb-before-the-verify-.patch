     st = e.st
+    prof = PROFILE
     logits = absorb(e, streams, next_tokens)
+    if prof is not None:
+        prof.mark("absorb launch*")
+    if after_absorb is not None:
+        after_absorb()
     if ahead is not None:
         ahead.send()                                     # row 0 while the absorb step runs
     drafts: list[int] = []
@@ -284,6 +292,9 @@ def draft(e: Engine, streams: torch.Tensor, next_tokens: Sequence[int], position
     chain = 1.0
     for j in range(count):
         low = False
