@@ -305,8 +316,12 @@ def draft(e: Engine, streams: torch.Tensor, next_tokens: Sequence[int], position
             st.set_mtp_len(st.mtp_len + 1)
             st.mtp_drafted += 1
             next_tokens = [d]
+            if prof is not None:
+                prof.mark("draft pick+launch*")
     if ahead is not None:
