diff --git a/src/tensorfold/families/qwen4_exp/cuda/roundprof.py b/src/tensorfold/families/qwen4_exp/cuda/roundprof.py
new file mode 100644
index 00000000..acaad104
--- /dev/null
+++ b/src/tensorfold/families/qwen4_exp/cuda/roundprof.py
@@ -0,0 +1,64 @@
+"""TF_ROUND_PROFILE=1: where a lone stream's decode round spends host time while the GPU waits (the done line's graph
+summary cannot split it). Marks are host clock readings at fixed points of the round; ``ready`` marks wait on an event
+recorded right after a graph's replay, so ``ready -> next launch`` is host time with nothing queued on the GPU. Every
+``TF_ROUND_PROFILE_EVERY`` rounds (default 400) the means per round are printed and reset. Off: no events, no syncs."""
+
+from __future__ import annotations
+
+import os
+import time
+
+ON = os.environ.get("TF_ROUND_PROFILE", "").strip() == "1"
+EVERY = int(os.environ.get("TF_ROUND_PROFILE_EVERY", "400") or 400)
+
+# phases, in round order (host stretches marked *, the GPU idles through them)
+PHASES = ("loop*", "stage+launch*", "main gpu", "sample+accept*", "commit*", "absorb launch*", "absorb gpu",
+          "draft pick+launch*", "draft gpu", "last pick*", "tail*")
+
+
+class Profile:
+    def __init__(self) -> None:
+        self.sums = dict.fromkeys(PHASES, 0.0)
+        self.rounds = 0
+        self.drafts = 0
+        self.last_end: float | None = None
+        self.t = 0.0
+        self.active = False                  # inside a lone round: draft() also runs in shared rounds and prefill
+
+    def ready(self, event) -> None:
+        """Wait for the graph whose replay recorded ``event`` (the caller's next read would wait for it anyway)."""
+
+        if event is not None and self.active:
+            event.synchronize()
+
+    def start(self) -> None:
+        now = time.perf_counter()
+        if self.last_end is not None and now - self.last_end < 0.05:     # a gap of a following round, not idle time
+            self.sums["loop*"] += now - self.last_end
+        self.t = now
+        self.active = True
+
+    def mark(self, phase: str) -> None:
+        if not self.active:
+            return
+        now = time.perf_counter()
+        self.sums[phase] += now - self.t
+        self.t = now
+
+    def end(self, drafts: int) -> None:
+        self.mark("tail*")
+        self.active = False
+        self.last_end = self.t
+        self.rounds += 1
+        self.drafts += drafts
+        if self.rounds >= EVERY:
+            n = self.rounds
+            host = sum(v for k, v in self.sums.items() if k.endswith("*"))
+            parts = " ".join(f"{k}={v / n * 1e3:.3f}" for k, v in self.sums.items())
+            print(f"[tensorfold] round profile ({n} lone rounds, {self.drafts / n:.2f} drafts/round, ms/round): "
+                  f"{parts} host_total={host / n * 1e3:.3f}", flush=True)
+            self.sums = dict.fromkeys(PHASES, 0.0)
+            self.rounds = self.drafts = 0
+
+
+PROFILE = Profile() if ON else None
